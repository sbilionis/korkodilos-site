---
pagination:
  data: langs
  size: 1
  alias: lang
permalink: "{{ '' if lang == 'el' else 'en/' }}studio.html"
layout: layouts/base.njk
pageKey: studio
file: studio.html
---
{%- set t = studio[lang] -%}{%- set u = ui[lang] -%}
<h1 class="visually-hidden">{{ t.h1 }}</h1>
<section class="section section--fit section--top bg-orange">
  <div class="container">
    <div class="content content--top">
      <img src="{{ t.hero_image }}" alt="{{ t.hero_alt }}" fetchpriority="high">
    </div>
  </div>
</section>
<section class="section section--fit bg-brown">
  <div class="container">
    <div class="content">
      {% set paras = t.intro.paragraphs %}{% set label = t.intro.label %}{% set cls = "" %}{% include "partials/paras.njk" %}
    </div>
  </div>
</section>
<section class="section section--fit bg-green" id="who">
  <div class="container">
    <div class="content"><p><em>{{ t.team.label }}</em> {{ t.team.text | mdi | safe }}</p></div>
    <div class="tutors swallow">
      {%- for p in tutors[lang].people %}
      <button class="tutor" type="button" data-cv="cv-{{ p.id }}">
        <span class="tutor__img">{% if p.photo %}<img sizes="(max-width: 768px) 50vw, 30vw" src="{{ p.photo }}" alt="{{ p.photo_alt }}" loading="lazy">{% else %}{% set kid = "t" + loop.index %}{% include "partials/k-static.njk" %}{% endif %}</span>
        <span class="tutor__name">{{ p.name }}</span>
        <span class="tutor__role">{{ p.role }}</span>
        <span class="tutor__cv">{{ u.bio }}</span>
      </button>
      {%- endfor %}
    </div>
    {%- if t.next and t.next.text %}
    <div class="actions actions--next swallow"><a class="btn btn--light" href="{{ t.next.link }}"><span class="gr">{{ t.next.text }}</span> →</a></div>
    {%- endif %}
  </div>
</section>
<section class="section section--fit bg-base">
  <div class="container">
    <div class="photo-k">{% set sz = t.k_photo | imgsize %}
      <img style="--ar:{{ t.k_photo | ratio }}" src="{{ t.k_photo }}" alt="{{ t.k_photo_alt }}" loading="lazy" width="{{ sz[0] }}" height="{{ sz[1] }}">
      <div class="photo-k__k" aria-hidden="true">{% set kid = "studio" %}{% include "partials/k.njk" %}</div>
    </div>
  </div>
</section>
<section class="section section--fit bg-green">
  <div class="container">
    <div class="content">
      {% set paras = t.table.paragraphs %}{% set label = t.table.label %}{% include "partials/paras.njk" %}
    </div>
    {%- if t.table.image %}
    <div class="sec-photo swallow"><img sizes="(max-width: 768px) 100vw, 560px" src="{{ t.table.image }}" alt="{{ t.table.image_alt }}" loading="lazy"></div>
    {%- endif %}
  </div>
</section>
<section class="section section--fit bg-pink">
  <div class="container">
    <div class="content">
      {% set paras = t.clay.paragraphs %}{% set label = t.clay.label %}{% include "partials/paras.njk" %}
    </div>
    {%- if t.clay.image %}
    <div class="sec-photo swallow"><img sizes="(max-width: 768px) 100vw, 560px" src="{{ t.clay.image }}" alt="{{ t.clay.image_alt }}" loading="lazy"></div>
    {%- endif %}
  </div>
</section>
<section class="section section--fit bg-base">
  <div class="container">
    <div class="content">
      {% set paras = t.tools.paragraphs %}{% set label = t.tools.label %}{% include "partials/paras.njk" %}
    </div>
    {%- if t.tools.image %}
    <div class="sec-photo swallow"><img sizes="(max-width: 768px) 100vw, 560px" src="{{ t.tools.image }}" alt="{{ t.tools.image_alt }}" loading="lazy"></div>
    {%- endif %}
  </div>
</section>
{%- for p in tutors[lang].people %}
<dialog class="cv" id="cv-{{ p.id }}" aria-labelledby="cv-{{ p.id }}-h">
  <div class="cv__inner">
    <div class="cv__img">{% if p.photo %}<img sizes="(max-width: 768px) 100vw, 220px" src="{{ p.photo }}" alt="{{ p.photo_alt }}" loading="lazy">{% else %}{% set kid = "c" + loop.index %}{% include "partials/k-static.njk" %}{% endif %}</div>
    <div>
      <h2 id="cv-{{ p.id }}-h" tabindex="-1" autofocus>{{ p.name }}</h2>
      <p class="cv__role">{{ p.role }}</p>
      {%- if p.bio and p.bio.length %}
      <div class="cv__bio">{% for b in p.bio %}<p>{{ b | mdi | safe }}</p>{% endfor %}</div>
      {%- else %}
      <ul>
        {%- for c in (p.cv or []) %}
        <li>{{ c.label }} — <span{% if p.cv_is_placeholder %} class="ph"{% endif %}>{{ c.value }}</span></li>
        {%- endfor %}
      </ul>
      {%- endif %}
      {%- if p.cv_is_placeholder %}
      <p class="ph-note" style="margin-top:22px">{{ u.bio_placeholder }}</p>
      {%- endif %}
    </div>
  </div>
  <button class="cv__close" type="button">{{ u.close }}</button>
</dialog>
{%- endfor %}
