---
pagination:
  data: langs
  size: 1
  alias: lang
permalink: "{{ '' if lang == 'el' else 'en/' }}index.html"
layout: layouts/base.njk
pageKey: home
file: index.html
---
{%- set t = home[lang] -%}{%- set u = ui[lang] -%}
<h1 class="visually-hidden">{{ t.h1 }}</h1>
<section class="section section--fit bg-base">
  <div class="container">
    <div class="content content--top">
      <div class="film" data-film>
        <div class="film__track" tabindex="0" aria-label="{{ u.film_label }}">
        {%- for ph in t.film %}{% set sz = ph.image | imgsize %}
        <img src="{{ ph.image }}" sizes="(max-width: 768px) 70vw, 30vw" alt="{{ ph.alt }}" width="{{ sz[0] }}" height="{{ sz[1] }}"{% if loop.index > 3 %} loading="lazy"{% elif loop.first %} fetchpriority="high"{% endif %}>
        {%- endfor %}
        </div>
        <button class="film__btn film__prev" type="button" aria-label="{{ u.prev_photos }}">←</button>
        <button class="film__btn film__next" type="button" aria-label="{{ u.next_photos }}">→</button>
      </div>
      <p class="hero__intro">{{ t.intro | mdi | safe }}</p>
    </div>
  </div>
</section>
<section class="section section--fit bg-pink">
  <div class="container">
    <div class="content">
      <p><em>{{ t.philosophy.label }}</em> {{ t.philosophy.lead | mdi | safe }}</p>
    </div>
    <div class="portrait">
      <figure class="swallow">{% set sz = t.philosophy.image | imgsize %}
        <img src="{{ t.philosophy.image }}" alt="{{ t.philosophy.image_alt }}" loading="lazy" width="{{ sz[0] }}" height="{{ sz[1] }}">
        <figcaption>{{ t.philosophy.caption }}</figcaption>
      </figure>
      <div class="content" style="padding-top:0">
        {% set paras = t.philosophy.paragraphs %}{% set label = "" %}{% set cls = "lead-small" %}{% include "partials/paras.njk" %}
      </div>
    </div>
  </div>
</section>
{%- if v.set %}
{#- ROUND 11 PROPOSAL: students' work gallery -#}
{%- set gal = [["k49.jpg","Κεραμικές φιγούρες μαθητών"],["k26.jpg","Γλυπτό βάζο με ξερά φυτά"],["k88.jpg","Έργα μαθητών στα χέρια τους"],["k38.jpg","Φρουτιέρα από πηλό"],["k15.jpg","Πήλινα γράμματα"],["k16.jpg","Ράφια με έργα μαθητών"]] %}
<section class="section section--fit bg-base gal-sec">
  <div class="container">
    <div class="content content--sm"><p><em>Από το τραπέζι μας</em> Μερικά από τα έργα που έφτιαξαν οι μαθητές μας.</p></div>
    <div class="gal gal--{{ v.set }} swallow">
      {%- for g in gal %}<img src="/assets/img/uploads/{{ g[0] }}" sizes="(max-width: 768px) 70vw, 30vw" alt="{{ g[1] }}" loading="lazy">{% endfor %}
    </div>
  </div>
</section>
{%- endif %}
<section class="section section--fit bg-pink">
  <div class="container">
    <div class="ti-block swallow">
      <p class="ti-block__label">{{ t.offers.label }}</p>
      <div class="ti-block__cols">
        {%- for o in t.offers.items %}
        <a class="ti-col" href="{{ o.link }}">{% if o.image %}<img src="{{ o.image }}" sizes="(max-width: 768px) 100vw, 30vw" alt="{{ o.image_alt }}" loading="lazy">{% else %}<span class="ph-img" aria-hidden="true">{{ u.image }}</span>{% endif %}<b>{{ o.title }}</b><span class="ti-col__p">{{ o.text | mdi | safe }}</span><span class="ti-col__x">{{ o.price }} <i>→</i></span></a>
        {%- endfor %}
      </div>
    </div>
  </div>
</section>
{%- if v.set %}
{#- ROUND 11 PROPOSAL: upcoming workshops (real ones from the calendar; samples only in the proposal build) -#}
{%- set wsl = programme[lang].specials if programme[lang].specials.length else [{date:"2026-10-24",time:"Σάββατο 11:00–15:00",title:"Καλούπια από γύψο",price:"€45",type:"workshop"},{date:"2026-11-07",time:"Σάββατο 12:00–15:00",title:"Τροχός για αρχάριους",price:"€40",type:"workshop"},{date:"2026-11-13",time:"Παρασκευή 19:30–22:30",title:"Clay & wine night",price:"€35",type:"event"}] %}
{%- if v.set == "a" %}
<section class="section section--fit bg-base ws-sec">
  <div class="container">
    <div class="content content--sm"><p><em>Επόμενα workshops</em> Τα επόμενα ειδικά μαθήματα στο τραπέζι μας.</p></div>
    <div class="ws-rows swallow">
      {%- for s in wsl %}{%- set dp = s.date.split("-") %}
      <a class="ws-row" href="calendar.html"><span class="ws-row__d">{{ dp[2] | int }} {{ ui[lang].months[(dp[1] | int) - 1] }}</span><span class="ws-row__t">{{ s.title }}<small>{{ s.time }}</small></span><span class="ws-row__p">{{ s.price }} <i>→</i></span></a>
      {%- endfor %}
    </div>
    <div class="actions swallow"><a class="btn" href="calendar.html"><span class="gr">Όλο το πρόγραμμα</span> →</a></div>
  </div>
</section>
{%- else %}
{%- set s = wsl[0] %}{%- set dp = s.date.split("-") %}
<section class="section section--fit bg-base ws-sec">
  <div class="container">
    <a class="ws-banner swallow" href="calendar.html"><span class="ws-banner__l">Επόμενο workshop</span><span class="ws-banner__d">{{ dp[2] | int }} {{ ui[lang].months[(dp[1] | int) - 1] }}</span><span class="ws-banner__t">{{ s.title }}<small>{{ s.time }} · {{ s.price }}</small></span><span class="ws-banner__a">Δες το →</span></a>
  </div>
</section>
{%- endif %}
{%- endif %}
