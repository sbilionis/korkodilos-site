---
pagination:
  data: langs
  size: 1
  alias: lang
permalink: "{{ '' if lang == 'el' else 'en/' }}privacy.html"
layout: layouts/base.njk
pageKey: privacy
file: privacy.html
---
{%- set t = legal[lang].privacy -%}
<h1 class="visually-hidden">{{ t.label }}</h1>
<section class="section section--fit section--top bg-base legal">
  <div class="container">
    <div class="content content--top content--sm">
      {% set paras = t.paragraphs %}{% set label = t.label %}{% set cls = "lead-small" %}{% include "partials/paras.njk" %}
    </div>
  </div>
</section>
