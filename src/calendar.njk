---
pagination:
  data: langs
  size: 1
  alias: lang
permalink: "{{ '' if lang == 'el' else 'en/' }}calendar.html"
layout: layouts/base.njk
pageKey: calendar
file: calendar.html
---
{%- set t = calendar[lang] -%}{%- set u = ui[lang] -%}{%- set pr = programme[lang] -%}
<h1 class="visually-hidden">{{ t.h1 }}</h1>
<section class="section section--fit bg-green">
  <div class="container">
    <div class="content content--top content--sm">
      <p><em>{{ t.intro.label }}</em> {{ t.intro.text | mdi | safe }}</p>
    </div>
    <div class="cal cal--days swallow">
      {%- for key in ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] %}
      <div class="cal-day">
        <div class="cal__h"><span class="l">{{ u.days[loop.index0] }}</span><span class="s">{{ u.days_short[loop.index0] }}</span></div>
        <div class="cal__d">
          {%- for s in pr.week[key] %}<span class="cal__s{% if s.title and s.title != 'Monthly 4×3' %} cal__s--other{% endif %}"><span class="l">{{ s.time }}</span><span class="s">{{ s.time | replace(":00", "") }}</span>{% if s.title and s.title != 'Monthly 4×3' %}<em class="cal__t">{{ s.title }}</em>{% endif %}</span>{% endfor -%}
        </div>
      </div>
      {%- endfor %}
    </div>
    <p class="cal-note swallow">{{ t.note }}</p>
  </div>
</section>
<section class="section section--fit bg-base" data-specials-section>
  <div class="container">
    <div class="content content--sm"><p><em>{{ t.specials.label }}</em> {{ t.specials.text | mdi | safe }}</p></div>
    <div class="specials swallow" data-specials>
      {%- for s in pr.specials | sort(false, false, "date") %}
      {%- set dp = s.date.split("-") %}
      <article class="special" data-date="{{ s.date }}">
        <div class="special__date">{{ dp[2] | int }} {{ u.months[(dp[1] | int) - 1] }}<small data-weekday>{{ s.time }}</small></div>
        <div><span class="special__type special__type--{{ s.type }}">{{ u.types[s.type] }}</span><h3><button class="special__open" type="button" data-cv="sp-{{ loop.index }}">{{ s.title }}</button></h3><p>{{ s.text | mdi | safe }}</p></div>
        <div class="special__side"><span>{{ s.price }}</span><span class="btn" aria-hidden="true"><span class="gr">{{ u.book_place }}</span> →</span></div>
      </article>
      {%- endfor %}
    </div>
  </div>
</section>
{#- each special opens a pop-up with more info + booking (the whole row is clickable) -#}
{%- for s in pr.specials | sort(false, false, "date") %}{%- set dp = s.date.split("-") %}
<dialog class="cv sp-dlg" id="sp-{{ loop.index }}" aria-labelledby="sp-{{ loop.index }}-h" data-date="{{ s.date }}">
  <div class="cv__inner{% if not s.image %} cv__inner--text{% endif %}">
    {%- if s.image %}<div class="cv__img"><img src="{{ s.image }}" alt="{{ s.image_alt }}" loading="lazy"></div>{% endif %}
    <div>
      <span class="special__type special__type--{{ s.type }}">{{ u.types[s.type] }}</span>
      <h2 id="sp-{{ loop.index }}-h" tabindex="-1" autofocus>{{ s.title }}</h2>
      <p class="cv__role">{{ dp[2] | int }} {{ u.months[(dp[1] | int) - 1] }} · {{ s.time }} · {{ s.price }}</p>
      <div class="sp-dlg__text">{% for para in (s.details or s.text).split("\n\n") %}<p>{{ para | mdi | safe }}</p>{% endfor %}</div>
      <a class="btn" href="#book"><span class="gr">{{ u.book_place }}</span> →</a>
    </div>
  </div>
  <button class="cv__close" type="button">{{ u.close }}</button>
</dialog>
{%- endfor %}
{%- if t.bottom_image %}
<div class="container calendar-end"><img class="calendar-bottom" src="{{ t.bottom_image }}" alt="{{ t.bottom_alt }}" loading="lazy"></div>
{%- endif %}
<script type="application/json" id="days-json">{{ u.days | dump | safe }}</script>
